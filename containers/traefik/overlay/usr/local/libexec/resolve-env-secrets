#!/usr/bin/env bash
# shellcheck shell=bash disable=SC2016

# `up` script of the op-secrets oneshot, invoked as:
#
#     with-contenv /usr/local/libexec/resolve-env-secrets
#
# `with-contenv` must stay on the `up` line rather than being applied in here.
# It is `emptyenv -p` + `s6-envdir`, so it discards the current environment --
# anything exported before chain-loading into it is lost, and any environment
# read before it runs is empty.

set -euo pipefail

readonly token_file='/run/secrets/op-token'
readonly config_dir="${XDG_CONFIG_HOME:-${HOME:-/root}/.config}/op"
readonly token_pattern='(?-i)(OP_SERVICE_ACCOUNT_TOKEN=[\x22\x27]?)?((?i)ops_[a-z0-9_-]+)([\x22\x27]?)'

if [[ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]] && [[ -f "${token_file}" ]] && [[ -r "${token_file}" ]]; then
  OP_SERVICE_ACCOUNT_TOKEN="$(rg --trim --no-column --no-line-number --replace='$2' "${token_pattern}" "${token_file}" | tr -d '[:space:]')"
  export OP_SERVICE_ACCOUNT_TOKEN
fi

if [[ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" && ! -d "${config_dir}" ]]; then
  printf '[op-secrets] no service account token set, skipping env secret resolution\n'
  exit 0
fi

# Record which variables hold op:// references *before* `op run` rewrites them,
# so the renderer writes back only those and leaves the rest of the supervision
# tree's environment alone.
OP_REF_KEYS="$(/usr/local/libexec/env-secret-refs)"
export OP_REF_KEYS

exec /usr/local/bin/op run -- /usr/local/libexec/render-env-secrets
