#!/usr/bin/env python3
"""Render `op`-resolved environment secrets into the s6-overlay envdir.

Intended to be run by `op run --`, so every `op://` reference in the
environment has already been replaced with its resolved value. Only the
variables named in OP_REFS are written back; everything else in the
environment belongs to the supervision tree and is left alone.
"""

import json
import os
import re
import sys
from pathlib import Path

ENVDIR: Path = Path("/run/s6/container_environment")
VALID_KEY: re.Pattern = re.compile(r"^[a-z_][a-z0-9_]*$", flags=re.IGNORECASE)


def is_valid_key(key: str) -> bool:
    """Determine if the supplied environment variable name is valid, and issue a warning if not."""
    if VALID_KEY.match(key):
        return True

    print(
        f"[op-secrets] declining to render malformed key: {key!r}",
        file=sys.stderr,
    )

    return False


def main() -> int:
    refs: tuple[tuple[str, str], ...] = tuple(
        (key, value)
        for key in filter(is_valid_key, json.loads(os.getenv("OP_REF_KEYS", "[]")))
        if (value := os.getenv(key)) is not None
    )

    if not refs:
        print("[op-secrets] no `op://` ref environment variables to resolve")
        return 0

    written = 0

    for key, value in refs:
        # `op run` exits non-zero on an unresolvable reference, so this should be
        # unreachable -- but a silent passthrough would hand traefik the literal
        # string `op://...` as an API token, which fails much less obviously.
        if value.lstrip().casefold().startswith("op://"):
            print(f"[op-secrets] op did not resolve {key}", file=sys.stderr)
            continue

        target, content = ENVDIR.joinpath(key), value.encode()

        if target.is_file() and target.read_bytes() == content:
            continue

        with target.open("wb") as writer:
            writer.write(content)

        # O_CREAT's mode is ignored when the file already exists, so set it
        # explicitly rather than inheriting 0644 from an earlier boot.
        target.chmod(0o600)

        written += 1

    print(
        f"[op-secrets] rendered {written} of {len(refs)} "
        f"resolved secret reference{'s' if written == 1 else ''}"
    )

    return 0


if __name__ == "__main__":
    sys.exit(main())
