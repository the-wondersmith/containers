#!/usr/bin/env python3
"""Print a JSON-formatted list of all environment variables whose values are 1Password secret references."""

import os
import sys
import json

if __name__ == "__main__":
    json.dump(
        [
            key
            for key, value in os.environ.items()
            if value.strip().casefold().startswith("op://")
        ],
        sys.stdout,
        separators=(",", ":"),
    )

    sys.exit(0)
