#!/usr/bin/env python3
"""Print a JSON-formatted list of all environment variables whose values are 1Password secret references."""

import json
import os
import sys

if __name__ == "__main__":
    print(
        json.dumps(
            [
                key
                for key, value in os.environ.items()
                if value.strip().casefold().startswith("op://")
            ],
            indent=0,
        )
    )

    sys.exit(0)
